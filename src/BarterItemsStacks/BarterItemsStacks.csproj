<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>BarterItemsStacks</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

	<PropertyGroup>
		<GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
		<GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
		<GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
		<GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
		<GenerateAssemblyAssemblyCopyrightAttribute>false</GenerateAssemblyAssemblyCopyrightAttribute>
		<GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="SPTushonka.Common" Version="4.1.3" />
		<PackageReference Include="SPTushonka.DI" Version="4.1.3" />
		<PackageReference Include="SPTushonka.Server.Core" Version="4.1.3" />
		<PackageReference Include="SPTushonka.Server.Web" Version="4.1.3" />
		<PackageReference Include="SPTushonka.Reflection" Version="4.1.3" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="Web/Assets/**/*.*"
						  Exclude="Web/Assets/items/items.zip"/>
	</ItemGroup>
	<ItemGroup>
		<Compile Include="../ModInfo.cs" />
	</ItemGroup>
	<ItemGroup>
		<_ContentIncludedByDefault Remove="Components/ItemRow.razor" />
		<_ContentIncludedByDefault Remove="Components/Search.razor" />
	</ItemGroup>
	
	<ItemGroup>
        <Content Include="../../presets/*.jsonc">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>presets/%(Filename)%(Extension)</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Folder Update="../../presets/"/>
    </ItemGroup>
	
	<Target Name="CopyToBuildFolder" AfterTargets="Build">
		<PropertyGroup>
			<DestDir>$(MSBuildProjectDirectory)/../../build/SPT_Runtime/user/mods/BarterItemsStacks/</DestDir>
		</PropertyGroup>
		<MakeDir Directories="$(DestDir)"/>
        <MakeDir Directories="$(DestDir)/presets"/>
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DestDir)" SkipUnchangedFiles="true" />
		<ItemGroup>
            <LocaleFiles Include="$(TargetDir)/presets/*.jsonc"/>
        </ItemGroup>
        <Copy SourceFiles="@(LocaleFiles)" DestinationFolder="$(DestDir)/presets/" SkipUnchangedFiles="true"/>
	</Target>
</Project>
